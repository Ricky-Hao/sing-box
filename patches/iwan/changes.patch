+	openAck := buildTestOpenAck([2]byte{0x12, 0x34}, [4]byte{0xde, 0xad, 0xbe, 0xef}, netip.MustParseAddr("10.20.30.40"))
+	if _, err = attacker.WriteTo(openAck, clientAddress); err != nil {
