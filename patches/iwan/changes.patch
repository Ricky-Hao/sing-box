+func TestEndpointFlowPortWritesAndReturnsPackets(t *testing.T) {
+	t.Parallel()
+	endpoint, server, cleanup := startTestEndpoint(t)
+	defer cleanup()
+	token := [2]byte{0x12, 0x34}
+	sessionID := [4]byte{0xde, 0xad, 0xbe, 0xef}
