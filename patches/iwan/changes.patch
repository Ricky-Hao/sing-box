+	server.access.Unlock()
+	udpPacket := buildIPv4UDPPacket(session.address, netip.MustParseAddr("198.51.100.1"), 12345, 53, []byte("ping"))
+	dataPacket := wrapDataPacket(session, udpPacket)
+	if !server.handleData(remote, dataPacket) {
